# Copy this file to .env at the repository root before using Docker Compose.
# Values below are placeholders for local/private deployment, not credentials.
POSTGRES_DB=ecomagent
POSTGRES_USER=ecomagent
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_PORT=5432
FRONTEND_PORT=8080
JWT_SECRET=replace-with-a-long-random-signing-secret

# Provider credentials are optional. Empty values produce observable safe
# no_key/degraded states and never enable a real external call.
LLM_PROVIDER=qwen
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=qwen-plus
IMAGE_PROVIDER=qwen
IMAGE_GEN_API_BASE=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=qwen-image-2.0
IMAGE_GEN_OUTPUT_COUNT=3
GOOGLE_API_KEY=
GOOGLE_TEXT_MODEL=gemini-2.5-flash
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image