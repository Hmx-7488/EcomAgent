DATABASE_URL=postgresql+psycopg://ecomagent:replace-with-a-strong-random-password@127.0.0.1:5432/ecomagent
DEBUG=true
UPLOAD_DIR=./uploads
JWT_SECRET=replace-with-a-long-random-signing-secret

# Runtime providers for local development
LLM_PROVIDER=qwen
IMAGE_PROVIDER=qwen

# DashScope/Qwen. Keep real values in .env only.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=qwen-plus
IMAGE_GEN_API_BASE=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=qwen-image-2.0
IMAGE_GEN_OUTPUT_COUNT=3
